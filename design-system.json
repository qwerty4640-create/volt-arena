{
  "name": "Berserker Protocol Design System",
  "version": "1.0.0",
  "theme": {
    "colors": {
      "void": "#0D0F0B",
      "surface": "#131313",
      "volt": "#00b6ff",
      "yellow": "#EAB308",
      "crimson": "#FF8D7A",
      "zinc": {
        "900": "#18181B",
        "800": "#27272A"
      }
    },
    "typography": {
      "base": "Inter",
      "variants": {
        "headline": {
          "weight": "900",
          "style": "italic",
          "case": "uppercase",
          "tracking": "tighter"
        },
        "technical": {
          "family": "mono",
          "weight": "bold",
          "case": "uppercase",
          "tracking": "widest"
        }
      }
    },
    "shapes": {
      "borderRadius": "0px"
    },
    "effects": {
      "blur": "40px",
      "glows": {
        "volt": "0 0 15px rgba(0, 182, 255, 0.6)"
      }
    }
  },
  "patterns": {
    "hardware_decor": {
      "corner_brackets": false,
      "tick_marks": false,
      "sensor_labels": false
    },
    "animations": {
      "tactical_pulse": "3s cubic-bezier(0.4, 0, 0.6, 1) infinite",
      "tap_feedback": "scale(0.97)"
    }
  }
}
